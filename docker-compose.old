services:
  rabbitmq:
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"

  docling:
    image: quay.io/docling-project/docling-serve:latest
    ports:
      - "8000:5001"
    environment:
      DOCLING_DEVICE: auto
      DOCLING_NUM_THREADS: 4
      LOG_LEVEL: info
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5001/openapi.json"]
      interval: 10s
      timeout: 5s
      retries: 10

  orchestrator:
    build:
      context: .
      dockerfile: cmd/orchestrator/Dockerfile
    ports:
      - "8080:8080"
    environment:
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      REDIS_URL: redis://redis:6379
      DOCLING_URL: http://docling:5001
      HTTP_PORT: "8080"
      LOG_LEVEL: info
      UPLOAD_PATH: /app/data/uploads
      RESULTS_PATH: /app/data/results
    depends_on:
      - rabbitmq
      - redis
      - docling
    volumes:
      - uploads:/app/data/uploads
      - results:/app/data/results

  extraction-worker:
    build:
      context: .
      dockerfile: cmd/extraction-worker/Dockerfile
    environment:
      REDIS_URL: redis://redis:6379
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      DOCLING_URL: http://docling:5001
      QUEUE_NAME: extract_text
      LOG_LEVEL: info
    depends_on:
      - redis
      - rabbitmq
      - docling
    volumes:
      - uploads:/app/data/uploads

volumes:
  uploads:
    driver: local
  results:
    driver: local
