                },
                "document_url": {
                    "type": "string"
                },
                "features": {
                    "description": "e.g. [\"inferences\"]",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "filename": {
                    "type": "string"
                },
                "webhook_secret": {
                    "type": "string"
                },
                "webhook_url": {
                    "type": "string"
                }
            }
