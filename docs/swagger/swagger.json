                    "type": "string"
                }
            }
        },
        "ia-text-orchestrator_internal_models.GetJobResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "job_id": {
                    "type": "string"
                },
                "results": {
                    "$ref": "#/definitions/ia-text-orchestrator_internal_models.JobResults"
                },
                "status": {
                    "$ref": "#/definitions/ia-text-orchestrator_internal_models.JobStatus"
                },
                "steps": {
