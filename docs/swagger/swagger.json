        "ia-text-orchestrator_internal_models.JobStatus": {
            "type": "string",
            "enum": [
                "pending",
                "extracting",
                "processing",
                "embedding",
                "entities",
                "inferences",
                "completed",
                "failed"
            ],
            "x-enum-varnames": [
                "StatusPending",
                "StatusExtracting",
                "StatusProcessing",
                "StatusEmbedding",
                "StatusEntities",
                "StatusInferences",
                "StatusCompleted",
                "StatusFailed"
