# IA Text Orchestrator - Environment Variables Example
# Copy this file to .env and fill in your values

# RabbitMQ Configuration
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password

# Grafana Configuration
GRAFANA_ADMIN_USER=your_grafana_admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# Redis Configuration
# REDIS_URL=redis://localhost:6379

# Unstructured API Configuration
# UNSTRUCTURED_URL=http://localhost:8000

# Resource Manager Configuration
# RESOURCE_MANAGER_URL=http://localhost:9090

# Orchestrator Configuration
# HTTP_PORT=8080
# LOG_LEVEL=info
# JOB_TTL=24h
# MAX_RETRIES=3
# RETRY_DELAY=1s

# Queue Names
# EMBEDDINGS_QUEUE=embeddings
# ENTITIES_QUEUE=entities
# EXTRACT_QUEUE=extract_text
# METADATA_QUEUE=metadata

# Worker Configuration
# PREFETCH_COUNT=5
# METRICS_PORT=8001

# Entities Worker - GLiNER Configuration
# GLINER_MODEL_PATH=/models/gliner_large
# GLINER_MODEL_NAME=urchade/gliner_large-v2.1
# ENTITY_TYPES=PER,ORG,LOC,DATE,MONEY
# ALLOW_REMOTE_DOWNLOAD=true

# Entities Worker - Confidence Thresholds (per entity type)
# ENTITY_THRESHOLD_PER=0.35        # Lower threshold for PERSON entities (detects more names)
# ENTITY_THRESHOLD_ORG=0.50        # ORGANIZATION entities
# ENTITY_THRESHOLD_LOC=0.50        # LOCATION entities
# ENTITY_THRESHOLD_DATE=0.60       # DATE entities
# ENTITY_THRESHOLD_MONEY=0.65      # MONEY entities

# Entities Worker - Deduplication
# DEDUPLICATION_ENABLED=true
# FUZZY_MATCH_THRESHOLD=0.85       # Fuzzy matching threshold (0.0-1.0)

# GPU/CPU Device Selection (optional, auto-detects if not set)
# Options: "cpu", "cuda", "cuda:0", "cuda:1", etc.
EMBEDDINGS_DEVICE=
ENTITIES_DEVICE=cpu
