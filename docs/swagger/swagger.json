                        "type": "string"
                    }
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "ia-text-orchestrator_internal_models.JobResults": {
            "type": "object",
            "properties": {
                "chunks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ia-text-orchestrator_internal_models.Chunk"
                    }
                },
                "completed_at": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "document_metadata": {
                    "type": "object",
                    "additionalProperties": true
                },
                "entities": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/ia-text-orchestrator_internal_models.EntityMinimal"
                    }
                },
                "job_id": {
                    "type": "string"
                },
                "source_classification": {
                    "$ref": "#/definitions/ia-text-orchestrator_internal_models.SourceClassificationResult"
