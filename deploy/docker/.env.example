# textFlow - Environment Variables Example
# Copy this file to .env and configure for your deployment.
#
# CRITICAL: This system is designed for AIR-GAPPED (on-premise) deployment
# All ML models must be pre-downloaded and mounted as volumes
# NO internet access is required or allowed at build/runtime

# ============================================================================
# AIR-GAPPED / OFFLINE MODE (CRITICAL - DO NOT CHANGE)
# ============================================================================

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ALLOW_REMOTE_DOWNLOAD=false

# ============================================================================
# MODEL PATHS (must match docker-compose volume mounts)
# ============================================================================

GLINER_MODEL_PATH=/models/gliner-small-v2.1
DEBERTA_MODEL_PATH=/models/deberta-v3-small
BGE_MODEL_PATH=/models/bge-m3
MODELS_PATH=../../models

# ============================================================================
# MESSAGE QUEUE & CACHE (RabbitMQ + Redis)
# ============================================================================

RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
RABBITMQ_USER=user
RABBITMQ_PASS=password
REDIS_URL=redis://redis:6379

# ============================================================================
# DOCUMENT EXTRACTION (Docling)
# ============================================================================

UNSTRUCTURED_URL=http://docling:8000
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
MAX_SPREADSHEET_ROWS=2000
MAX_SPREADSHEET_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# ============================================================================
# WEBHOOKS (Optional)
# ============================================================================

WEBHOOK_URL=

# ============================================================================
# ORCHESTRATOR
# ============================================================================

HTTP_PORT=8080
LOG_LEVEL=info
JOB_TTL=24h
MAX_RETRIES=3
RETRY_DELAY=1s
DELAYED_EXCHANGE_ENABLED=true

# ============================================================================
# MESSAGE QUEUE CONFIGURATION
# ============================================================================

EXTRACT_QUEUE=extract_text
EMBEDDINGS_QUEUE=embeddings
ENTITIES_QUEUE=entities
METADATA_QUEUE=metadata
COMPLETION_QUEUE=completion
PREFETCH_COUNT=5

# ============================================================================
# ENTITY EXTRACTION (GLiNER + Regex Service)
# ============================================================================

ENTITY_TYPES=PERSON,ORGANIZATION,LOCATION,DATE,MONEY,EMAIL
ENTITY_THRESHOLD_PERSON=0.30
ENTITY_THRESHOLD_ORGANIZATION=0.35
ENTITY_THRESHOLD_LOCATION=0.35
ENTITY_THRESHOLD_DATE=0.45
ENTITY_THRESHOLD_MONEY=0.55
DEDUPLICATION_ENABLED=false
FUZZY_MATCH_THRESHOLD=0.85
REGEX_ENTITY_EXTRACTOR_URL=http://regex-entity-extractor:8081

# ============================================================================
# EMBEDDINGS WORKER
# ============================================================================

EMBEDDINGS_DEVICE=cuda
EMBEDDINGS_METRICS_PORT=8001
EMBEDDINGS_BATCH_SIZE=32

# ============================================================================
# ENTITIES WORKER
# ============================================================================

ENTITIES_DEVICE=cuda
ENTITIES_METRICS_PORT=8002

# ============================================================================
# METADATA WORKER
# ============================================================================

METADATA_METRICS_PORT=8003

# ============================================================================
# RESOURCE MANAGER
# ============================================================================

RESOURCE_MANAGER_PORT=9090
GPU_MONITORING_ENABLED=false

# ============================================================================
# INFERENCE WORKER
# ============================================================================

# Base URL of the LLM server (no /v1 suffix)
# For vLLM in Docker Compose: http://vllm-qwen-2b:8000
# For mlx-serve on mac-mini: http://mac-mini:11234
# For vLLM on host: http://localhost:8000
LLM_URL=http://vllm-qwen-2b:8000
LLM_MODEL=qwen3-coder
INFERENCES_QUEUE=inferences
INFERENCE_LLM_TIMEOUT=300
INFERENCE_WORKER_REPLICAS=4

# Inference quality tuning: dynamic max facts per chunk size (word count)
# SHORT = chunks with < 200 words, MEDIUM = 200-499 words, LONG = >= 500 words
MAX_INFERENCES_SHORT=1
MAX_INFERENCES_MEDIUM=2
MAX_INFERENCES_LONG=3
MIN_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# COMPLETION WORKER
# ============================================================================

FUZZY_MATCH_THRESHOLD=0.85
