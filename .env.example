# RabbitMQ Configuration
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password

# Redis Configuration (optional, defaults to no password)
REDIS_PASSWORD=

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Application Configuration
LOG_LEVEL=info
HTTP_PORT=8080
JOB_TTL=24h
MAX_RETRIES=3
RETRY_DELAY=1s

# Service URLs (internal Docker network, no need to change)
REDIS_URL=redis://redis:6379
UNSTRUCTURED_URL=http://unstructured:8000
RESOURCE_MANAGER_URL=http://resource-manager:9090

# Queue Names
EMBEDDINGS_QUEUE=embeddings
ENTITIES_QUEUE=entities
METADATA_QUEUE=metadata

# Metrics Ports
ORCHESTRATOR_METRICS_PORT=8080
EMBEDDINGS_METRICS_PORT=8001
ENTITIES_METRICS_PORT=8002
METADATA_METRICS_PORT=8003
