# Otros             # Go/Python binaries built locally, not source
deploy/.env             # Ignore .env files but track docker-compose.yml
deploy/.env.local
deploy/.env.*.local
data/

# Git worktrees
.worktrees/
bin/*
tools/client/client
tools/client/client_test_build

