                    }
                },
                "start_offset": {
                    "type": "integer"
                },
                "text": {
                    "type": "string"
                },
                "token_count": {
                    "type": "integer"
                }
            }
        },
        "ia-text-orchestrator_internal_models.CreateJobRequest": {
