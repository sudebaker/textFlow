[
    {
        "label": "EMAIL",
        "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
    },
    {
        "label": "PHONE",
        "pattern": "(?:Tel(?:éfono|f)?[:\\.\\s]*)?\\+\\d{1,3}(?:[\\s-]\\d{2,4}){2,4}\\b"
    },
    {
        "label": "CREDIT_CARD",
        "pattern": "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|6(?:011|5[0-9]{2})[0-9]{12}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|(?:2131|1800|35\\d{3})\\d{11})\\b"
    },
    {
        "label": "IBAN_ES",
        "pattern": "\\bES\\d{2}(?:\\s?\\d{4}){2}\\s?\\d{2}\\s?\\d{10}\\b"
    },
    {
        "label": "IBAN_INTL",
        "pattern": "\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){2,7}\\b"
    },
    {
        "label": "DNI_ES",
        "pattern": "\\b[0-9]{8}[A-HJ-NP-ZTRWAGMYFPDXBNJZSQVHLCKE]\\b"
    },
    {
        "label": "NIF_ES",
        "pattern": "\\b(?:[XYZ][0-9]{7}[A-Z]|[0-9]{8}[A-Z])\\b"
    },
    {
        "label": "CIF_ES",
        "pattern": "\\b[ABCDEFGHJNPQRSUVW][0-9]{7}[0-9A-J]\\b"
    },
    {
        "label": "VAT_ES",
        "pattern": "\\bES[A-Z0-9]{9,12}\\b"
    },
    {
        "label": "LICENSE_PLATE_ES",
        "pattern": "\\b[0-9]{4}\\s?[BCDFGHJKLMNPRSTVWXYZ]{3}\\b"
    },
    {
        "label": "CRYPTO_BTC_ADDRESS",
        "pattern": "\\b[13][a-km-zA-HJ-NP-Z1-9]{25,34}\\b"
    },
    {
        "label": "GEOLOCATION_DMS",
        "pattern": "\\b\\d{1,3}[°d]\\s*\\d{1,2}['’´m]\\s*\\d{1,2}(?:\\.\\d+)?[\"”s]?\\s*[NnSs]\\s*,?\\s*\\d{1,3}[°d]\\s*\\d{1,2}['’´m]\\s*\\d{1,2}(?:\\.\\d+)?[\"”s]?\\s*[EeWwOo]\\b"
    },
    {
        "label": "GEOLOCATION_DMS",
        "pattern": "\\b\\d{1,3}°\\s*\\d{1,2}'\\s*\\d{1,2}(?:\\.\\d+)?\"\\s*[NnSs]\\s*,?\\s*\\d{1,3}°\\s*\\d{1,2}'\\s*\\d{1,2}(?:\\.\\d+)?\"\\s*[EeWw]\\b"
    },
    {
        "label": "GEOLOCATION_DD",
        "pattern": "\\b-?\\d{1,3}\\.\\d+[°d]?\\s*,\\s*-?\\d{1,3}\\.\\d+[°d]?\\b"
    },
    {
        "label": "GEOLOCATION_DD",
        "pattern": "\\b-?\\d{1,2}[°d]\\s*,\\s*-?\\d{1,3}[°d]\\b"
    },
    {
        "label": "URL",
        "pattern": "https?://(?:www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b(?:[-a-zA-Z0-9()@:%_\\+.~#?&//=]*)"
    },
    {
        "label": "IPV4",
        "pattern": "\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\b"
    },
    {
        "label": "MAC_ADDRESS",
        "pattern": "(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}"
    },
    {
        "label": "PASSPORT_EU",
        "pattern": "\\b[A-Z0-9<]{9}[0-9][A-Z]{3}[0-9]{7}[A-Z][0-9]{7}[A-Z0-9<]{14}[0-9]{2}\\b"
    },
    {
        "label": "HASHTAG",
        "pattern": "#[\\w_]+"
    },
    {
        "label": "SOCIAL_MENTION",
        "pattern": "@[\\w_]+"
    },
    {
        "label": "DATE",
        "pattern": "\\b(?:0?[1-9]|[12][0-9]|3[01])[/-](?:0?[1-9]|1[0-2])[/-](?:19|20)[0-9]{2}\\b"
    },
    {
        "label": "DATE",
        "pattern": "\\b(?:19|20)[0-9]{2}[/-](?:0[1-9]|1[0-2])[/-](?:0[1-9]|[12][0-9]|3[01])\\b"
    },
    {
        "label": "DATE",
        "pattern": "(?i)\\b(?:0?[1-9]|[12][0-9]|3[01])\\s+(?:de\\s+)?(?:enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)\\s+(?:de\\s+)?(?:19|20)\\d{2}\\b"
    },
    {
        "label": "DATE",
        "pattern": "(?i)\\b(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+(?:0?[1-9]|[12][0-9]|3[01]),?\\s+(?:19|20)\\d{2}\\b"
    },
    {
        "label": "DATE",
        "pattern": "(?i)\\b(?:0?[1-9]|[12][0-9]|3[01])\\s+(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\.?\\s+(?:19|20)\\d{2}\\b"
    },
    {
        "label": "DATE",
        "pattern": "(?i)\\b(?:enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)\\s+(?:de\\s+)?(?:19|20)\\d{2}\\b"
    },
    {
        "label": "DATE",
        "pattern": "(?i)\\b(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+(?:19|20)\\d{2}\\b"
    }
]
