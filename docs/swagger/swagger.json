{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/v1/documents/process": {
            "post": {
                "description": "Submit a document for async processing. Returns job_id for polling.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Process a document",
                "parameters": [
                    {
                        "description": "Document processing request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.CreateJobRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.CreateJobResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/documents/upload": {
            "post": {
                "description": "Upload a document via multipart/form-data for async processing.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Upload a document",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Document file",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Filename",
                        "name": "filename",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Webhook URL for completion notification",
                        "name": "notify_webhook",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.CreateJobResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/documents/{id}": {
            "get": {
                "description": "Retrieve current status and results of a processing job.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get job status and results",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.GetJobResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Remove a completed or failed job and its associated data.",
                "summary": "Delete a job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/documents/{id}/download": {
            "get": {
                "description": "Download the full JSON results for a completed job.",
                "produces": [
                    "application/json"
                ],
                "summary": "Download job results",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Compression type (gzip)",
                        "name": "compression",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.JobResults"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ia-text-orchestrator_internal_models.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
