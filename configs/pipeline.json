{
  "version": "v2",
  "profiles": {
    "rag": {
      "downstream": ["embeddings", "inferences"]
    },
    "full": {
      "downstream": ["embeddings", "entities", "metadata", "inferences"],
      "image_description": true
    }
  },
  "types": {
    "document": {
      "entry": "extraction",
      "capabilities": ["chunking"]
    },
    "spreadsheet": {
      "entry": "extraction",
      "capabilities": ["chunking"]
    },
    "audio": {
      "entry": "audio",
      "capabilities": ["chunking"]
    },
    "image": {
      "entry": "image",
      "capabilities": ["chunking"]
    }
  },
  "feature_extras": {
    "inferences": {
      "step": "inferences",
      "queue": "inferences"
    }
  },
  "rules": {
    "audio_replaces_extraction": true,
    "image_replaces_extraction": true
  }
}
