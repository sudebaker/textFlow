# IA Text Orchestrator - Environment Variables
# Copy this file to .env and configure for your deployment
#
# CRITICAL: This system is designed for AIR-GAPPED (on-premise) deployment
# All ML models must be pre-downloaded and mounted as volumes
# NO internet access is required or allowed at build/runtime

# ============================================================================
# 🔒 AIR-GAPPED / OFFLINE MODE (CRITICAL - DO NOT CHANGE)
# ============================================================================

# Prevent HuggingFace Hub downloads at build/runtime
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Allow local model files only (no fallback to HuggingFace)
ALLOW_REMOTE_DOWNLOAD=false

# ============================================================================
# 📦 MODEL PATHS (must match docker-compose volume mounts)
# ============================================================================

# GLiNER entity extraction model
# Pre-downloaded to: ./models/gliner-small-v2.1/
# Files required: gliner_config.json, pytorch_model.bin
GLINER_MODEL_PATH=/models/gliner-small-v2.1

# DeBERTa tokenizer backbone for GLiNER
# Pre-downloaded to: ./models/deberta-v3-small/
# Files required: config.json, pytorch_model.bin, spm.model, tokenizer_config.json
DEBERTA_MODEL_PATH=/models/deberta-v3-small

# BGE-M3 embeddings model
# Pre-downloaded to: ./models/bge-m3/
# Files required: various pytorch files (see docker logs for details)
BGE_MODEL_PATH=/models/bge-m3

# Host path to the models directory, resolved relative to the compose file.
# Dev (compose runs from deploy/docker/): ../../models
# Deployment target (set automatically by install.sh): ../models
MODELS_PATH=../../models

# ============================================================================
# 🔌 MESSAGE QUEUE & CACHE (RabbitMQ + Redis)
# ============================================================================

# RabbitMQ connection (use docker-compose service name when in containers)
RABBITMQ_URL=amqp://rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Redis cache connection (use docker-compose service name when in containers)
REDIS_URL=redis://redis:6379

# ============================================================================
# 📄 DOCUMENT EXTRACTION (Docling)
# ============================================================================

# Docling API endpoint for PDF/image text extraction
UNSTRUCTURED_URL=http://docling:8000

# Docling device: "cpu", "cuda", "cuda:0", etc. (auto-detects if not set)
DOCLING_DEVICE=auto

# Docling worker threads
DOCLING_NUM_THREADS=4

# Spreadsheet processing limits
MAX_SPREADSHEET_ROWS=2000
MAX_SPREADSHEET_SIZE_MB=5

# ============================================================================
# 🔔 WEBHOOKS (Optional - for external notifications)
# ============================================================================

# Webhook URL for job completion notifications (leave empty to disable)
WEBHOOK_URL=

# ============================================================================
# 🎯 ORCHESTRATOR (Main Service)
# ============================================================================

# HTTP server port
HTTP_PORT=8080

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Job configuration
JOB_TIMEOUT=60m                # Max time for a job before watchdog kills it
JOB_TTL=24h                   # How long to keep completed jobs in Redis
MAX_RETRIES=3                 # Max retries per worker before dead-lettering
RETRY_DELAY=1s                # Initial delay before retry (exponential backoff)

# ============================================================================
# 🐇 MESSAGE QUEUE CONFIGURATION
# ============================================================================

# Queue names (must match worker subscribers)
EXTRACT_QUEUE=extract_text    # Extraction worker
EMBEDDINGS_QUEUE=embeddings   # Embeddings worker
ENTITIES_QUEUE=entities       # Entities worker
METADATA_QUEUE=metadata       # Metadata worker
COMPLETION_QUEUE=completion   # Completion worker

# Worker prefetch count (how many messages to fetch before processing)
PREFETCH_COUNT=5

# ============================================================================
# 🏷️ ENTITY EXTRACTION (GLiNER + Regex Service)
# ============================================================================

# Entity types to extract (comma-separated)
# Supported: PERSON, ORGANIZATION, LOCATION, DATE, MONEY, EMAIL
ENTITY_TYPES=PERSON,ORGANIZATION,LOCATION,DATE,MONEY,EMAIL

# Confidence thresholds per entity type (0.0-1.0, lower = more entities detected)
# Recommended values based on testing:
# Note: docker-compose uses GLINER_*_THRESHOLD format internally
ENTITY_THRESHOLD_PERSON=0.30        # Names (generous threshold)
ENTITY_THRESHOLD_ORGANIZATION=0.35  # Companies/orgs
ENTITY_THRESHOLD_LOCATION=0.35      # Geographic locations
ENTITY_THRESHOLD_DATE=0.45          # Dates (can be tricky)
ENTITY_THRESHOLD_MONEY=0.55         # Currency amounts

# GLiNER model name (for reference, actual model loaded from GLINER_MODEL_PATH)
# GLINER_MODEL_NAME=urchade/gliner-small-v2.1  (informational only)

# Entity deduplication
# KNOWN ISSUE: Set to false (threshold too aggressive when enabled)
DEDUPLICATION_ENABLED=false
FUZZY_MATCH_THRESHOLD=0.85          # (Not used when DEDUPLICATION_ENABLED=false)

# Regex Entity Extractor service (extracts EMAIL, PHONE, IBAN, DNI, etc.)
REGEX_ENTITY_EXTRACTOR_URL=http://regex-entity-extractor:8081

# ============================================================================
# 💻 EMBEDDINGS WORKER
# ============================================================================

# Device selection: "cpu", "cuda", "cuda:0", "cuda:1"
# Leave empty to auto-detect (will use cuda if available)
EMBEDDINGS_DEVICE=cuda

# Metrics server port
EMBEDDINGS_METRICS_PORT=8001

# Batch size for embeddings processing
EMBEDDINGS_BATCH_SIZE=32

# ============================================================================
# 🏷️ ENTITIES WORKER
# ============================================================================

# Device selection: "cpu", "cuda", or leave empty for auto-detect (cuda if available)
ENTITIES_DEVICE=

# Metrics server port
ENTITIES_METRICS_PORT=8002

# ============================================================================
# 📊 METADATA WORKER
# ============================================================================

# Metrics server port
METADATA_METRICS_PORT=8003

# ============================================================================
# 📈 RESOURCE MANAGER
# ============================================================================

# Resource manager HTTP port
RESOURCE_MANAGER_PORT=9090

# GPU monitoring enabled (if you have nvidia-smi available)
GPU_MONITORING_ENABLED=false

# ============================================================================
# 📋 DEVELOPMENT / DEBUGGING
# ============================================================================

# Uncomment to enable debug logging (very verbose)
# LOG_LEVEL=debug

# Uncomment to skip entity deduplication (faster but more duplicates)
# DEDUPLICATION_ENABLED=false

# ============================================================================
# ⚠️ DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production:
# 
# 1. Ensure models are pre-downloaded to ./models/ on the host:
#    - models/gliner-small-v2.1/
#    - models/deberta-v3-small/
#    - models/bge-m3/
# 
# 2. Verify docker-compose.yml has correct volume mounts:
#    - -v ../../models:/models:ro
# 
# 3. Test offline mode:
#    - docker run --network=none docker-entities-worker /entrypoint.sh
# 
# 4. Set HF_HUB_OFFLINE=1 and TRANSFORMERS_OFFLINE=1 (already set above)
# 
# 5. Verify no internet-facing model download attempts in logs:
#    - docker compose logs entities-worker | grep -i "http\|download\|hub"
# 
# 6. Confirm all services start without errors:
#    - docker compose up -d && sleep 30 && docker compose ps

# ============================================================================
# 🤖 INFERENCE WORKER (vLLM)
# ============================================================================
# These variables enable the inference feature using an external vLLM server.
# REQUIRED if you want to use the --inferences flag in the E2E client.
#
# LLM_URL: Base URL of the vLLM server (no /v1 suffix, just the domain)
#   - For local dev with vLLM on host: http://localhost:8000
#   - For Docker Compose: http://vllm-qwen-2b:8000 (requires docker_default network)
#   - For production: set to your deployed vLLM endpoint
#
# LLM_MODEL: Model name loaded in the vLLM server (e.g., qwen3-coder, mistral-7b)
# INFERENCES_QUEUE: RabbitMQ queue name for inference tasks (default: inferences)

LLM_URL=http://vllm-qwen-2b:8000
LLM_MODEL=qwen3.5-2b
INFERENCES_QUEUE=inferences

# Inference quality tuning: dynamic max facts per chunk size (word count)
# SHORT = chunks with < 200 words, MEDIUM = 200-499 words, LONG = >= 500 words
MAX_INFERENCES_SHORT=1
MAX_INFERENCES_MEDIUM=2
MAX_INFERENCES_LONG=3
# Minimum confidence threshold for extracted facts (0.0-1.0)
MIN_CONFIDENCE_THRESHOLD=0.7
