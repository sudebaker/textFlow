# IA Text Orchestrator - Environment Variables Example
# Copy this file to .env and fill in your values

# RabbitMQ Configuration
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password

# Grafana Configuration
GRAFANA_ADMIN_USER=your_grafana_admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# Redis Configuration
# REDIS_URL=redis://localhost:6379

# Unstructured API Configuration
# UNSTRUCTURED_URL=http://localhost:8000

# Resource Manager Configuration
# RESOURCE_MANAGER_URL=http://localhost:9090

# Orchestrator Configuration
# HTTP_PORT=8080
# LOG_LEVEL=info
# JOB_TTL=24h
# MAX_RETRIES=3
# RETRY_DELAY=1s

# Queue Names
# EMBEDDINGS_QUEUE=embeddings
# ENTITIES_QUEUE=entities
# EXTRACT_QUEUE=extract_text
# METADATA_QUEUE=metadata

# Worker Configuration
# PREFETCH_COUNT=5
# METRICS_PORT=8001
