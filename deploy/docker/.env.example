# textFlow - Environment Variables Example
# Copy this file to .env and configure for your deployment.
#
# CRITICAL: This system is designed for AIR-GAPPED (on-premise) deployment
# All ML models must be pre-downloaded and mounted as volumes
# NO internet access is required or allowed at build/runtime

***REMOVED***================
# AIR-GAPPED / OFFLINE MODE (CRITICAL - DO NOT CHANGE)
***REMOVED***================

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ALLOW_REMOTE_DOWNLOAD=false

***REMOVED***================
# MODEL PATHS (must match docker-compose volume mounts)
***REMOVED***================

GLINER_MODEL_PATH=/models/gliner-small-v2.1
DEBERTA_MODEL_PATH=/models/deberta-v3-small
BGE_MODEL_PATH=/models/bge-m3
MODELS_PATH=../../models

***REMOVED***================
# MESSAGE QUEUE & CACHE (RabbitMQ + Redis)
***REMOVED***================

RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
RABBITMQ_USER=user
RABBITMQ_PASS=password
REDIS_URL=redis://redis:6379

***REMOVED***================
# DOCUMENT EXTRACTION (Docling)
***REMOVED***================

UNSTRUCTURED_URL=http://docling:8000
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
MAX_SPREADSHEET_ROWS=2000
MAX_SPREADSHEET_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

***REMOVED***================
# WEBHOOKS (Optional)
***REMOVED***================

WEBHOOK_URL=

***REMOVED***================
# ORCHESTRATOR
***REMOVED***================

HTTP_PORT=8080
LOG_LEVEL=info
JOB_TTL=24h
MAX_RETRIES=3
RETRY_DELAY=1s
DELAYED_EXCHANGE_ENABLED=true

***REMOVED***================
# ADMISSION CONTROL (prevents system overload)
***REMOVED***================

# Rate limit for document ingestion (jobs per second, burst=2x)
INGESTION_RATE_LIMIT=10
INGESTION_RATE_BURST=20

# Maximum concurrent jobs in the system (tracked in Redis)
MAX_CONCURRENT_JOBS=30

# Reject new jobs when extraction queue exceeds this depth
QUEUE_DEPTH_REJECT_THRESHOLD=500

***REMOVED***================
# MESSAGE QUEUE CONFIGURATION
***REMOVED***================

EXTRACT_QUEUE=extract_text
EMBEDDINGS_QUEUE=embeddings
ENTITIES_QUEUE=entities
METADATA_QUEUE=metadata
COMPLETION_QUEUE=completion
PREFETCH_COUNT=5

# Queue length limits (0 = unlimited, >0 = reject-publish when full)
QUEUE_MAX_LENGTH=1000

***REMOVED***================
# ENTITY EXTRACTION (GLiNER + Regex Service)
***REMOVED***================

ENTITY_TYPES=PERSON,ORGANIZATION,LOCATION,DATE,MONEY,EMAIL
ENTITY_THRESHOLD_PERSON=0.30
ENTITY_THRESHOLD_ORGANIZATION=0.35
ENTITY_THRESHOLD_LOCATION=0.35
ENTITY_THRESHOLD_DATE=0.45
ENTITY_THRESHOLD_MONEY=0.55
DEDUPLICATION_ENABLED=false
FUZZY_MATCH_THRESHOLD=0.85
REGEX_ENTITY_EXTRACTOR_URL=http://regex-entity-extractor:8081

***REMOVED***================
# EMBEDDINGS WORKER
***REMOVED***================

EMBEDDINGS_DEVICE=cuda
EMBEDDINGS_METRICS_PORT=8001
EMBEDDINGS_BATCH_SIZE=64

***REMOVED***================
# ENTITIES WORKER
***REMOVED***================

ENTITIES_DEVICE=cuda
ENTITIES_METRICS_PORT=8002

***REMOVED***================
# METADATA WORKER
***REMOVED***================

METADATA_METRICS_PORT=8003

***REMOVED***================
# RESOURCE MANAGER
***REMOVED***================

RESOURCE_MANAGER_PORT=9090
GPU_MONITORING_ENABLED=false

***REMOVED***================
# INFERENCE WORKER
***REMOVED***================

# Base URL of the LLM server (no /v1 suffix)
# For vLLM in Docker Compose: http://vllm-qwen-2b:8000
# For mlx-serve on mac-mini: http://mac-mini:11234
# For vLLM on host: http://localhost:8000
LLM_URL=http://vllm-qwen-2b:8000
LLM_MODEL=qwen3-coder
INFERENCES_QUEUE=inferences
INFERENCE_LLM_TIMEOUT=300
INFERENCE_WORKER_REPLICAS=4

# Inference quality tuning: dynamic max facts per chunk size (word count)
# SHORT = chunks with < 200 words, MEDIUM = 200-499 words, LONG = >= 500 words
MAX_INFERENCES_SHORT=1
MAX_INFERENCES_MEDIUM=2
MAX_INFERENCES_LONG=3
MIN_CONFIDENCE_THRESHOLD=0.7

***REMOVED***================
# ADAPTIVE LLM CONCURRENCY (TCP-like flow control)
***REMOVED***================

# Enable/disable adaptive concurrency control (true/false)
INFERENCE_ADAPTIVE_ENABLED=false

# Maximum concurrent LLM requests per worker
# Formula: VRAM_bytes / (max_chunk_tokens * 2 * bytes_per_token)
# Examples:
#   A40 48GB, chunk 4096, fp16: ~32 (limit to 32 for safety)
#   RTX 3090 24GB, chunk 4096, fp16: ~16
#   Mac M2 16GB unified, chunk 4096: ~8
INFERENCE_MAX_CONCURRENCY=16
INFERENCE_MIN_CONCURRENCY=1

# Target tokens per second for adaptive decision (ms/token equivalent)
# If tokens_per_sec > this value → additive increase (window grows)
# If tokens_per_sec < this value / 2 → multiplicative decrease (window halves)
INFERENCE_TARGET_TOKENS_PER_SEC=10

# Multiplicative decrease divisor (window halves by this factor on error)
INFERENCE_TIMEOUT_DECAY_FACTOR=2

# Circuit breaker: cooldown after N consecutive errors
INFERENCE_COOLDOWN_SECONDS=30
INFERENCE_CONSECUTIVE_ERRORS_FOR_COOLDOWN=5

# Global max concurrency across all workers (0 = disabled, uses Redis semaphore)
INFERENCE_GLOBAL_MAX_CONCURRENCY=0

***REMOVED***================
# COMPLETION WORKER
***REMOVED***================

FUZZY_MATCH_THRESHOLD=0.85

***REMOVED***================
# API AUTHENTICATION
***REMOVED***================
# API key for orchestrator REST API authentication.
# If empty, auth is DISABLED (dev mode only — never disable in production).
# Must be at least 32 characters. Generate with: openssl rand -hex 32
#
# All /v1/* endpoints require X-API-Key header when this is set.
# /health and /metrics remain public for health checks and Prometheus.

API_KEY=
